# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : serveur uniquement (invitations, rappels). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publique de l'application (liens d'invitation et e-mails)
NEXT_PUBLIC_SITE_URL=https://kbs-comptable.com

# Analyse des reçus fournisseurs (photo ou texte) — API Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Rappels quotidiens par e-mail (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="KBS Comptable <rappels@kbs-comptable.com>"

# Secret de la tâche planifiée (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=change-moi
